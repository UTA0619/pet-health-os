{
  "name": "pet-health-os",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native predictive pet health operating system",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "test:e2e": "turbo test:e2e",
    "test:integration": "supabase test db",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/database/src/types.ts",
    "db:reset": "supabase db reset"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^6.0.3",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
