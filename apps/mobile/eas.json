{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://web-utastudents-projects.vercel.app",
        "EXPO_PUBLIC_SUPABASE_URL": "https://vrqzvszhmbajaouinuhk.supabase.co"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://web-utastudents-projects.vercel.app",
        "EXPO_PUBLIC_SUPABASE_URL": "https://vrqzvszhmbajaouinuhk.supabase.co"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://web-utastudents-projects.vercel.app",
        "EXPO_PUBLIC_SUPABASE_URL": "https://vrqzvszhmbajaouinuhk.supabase.co"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "YOUR_APPLE_ID@email.com",
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
