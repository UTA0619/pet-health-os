{
  "expo": {
    "name": "Pet Health OS",
    "slug": "pet-health-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pethealthos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pethealthos.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ペットの写真を撮影して健康診断に使用します",
        "NSMicrophoneUsageDescription": "動画撮影時に使用します",
        "NSPhotoLibraryUsageDescription": "ペットの写真を選択するために使用します"
      }
    },
    "android": {
      "package": "com.pethealthos.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10b981"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE", "INTERNET"],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "ペットの写真を撮影して健康診断に使用します" }],
      ["expo-notifications", {
        "icon": "./assets/icon.png",
        "color": "#10b981"
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "pet-health-os"
      }
    }
  }
}
