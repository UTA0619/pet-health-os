# ============================================================
# Pet Health OS — Environment Variables Reference
# Copy to .env.local for local development.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# ── APP ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development               # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Pet Health OS"

# ── SUPABASE ─────────────────────────────────────────────────
# [PUBLIC] Safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [SECRET] Server / Edge Functions only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Supabase project references (for CLI commands)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_STAGING_PROJECT_REF=your-staging-ref

# ── OPENAI ───────────────────────────────────────────────────
# [SECRET] Server / Edge Functions only
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=org-...

# Model configuration
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# Token limits per task type
OPENAI_MAX_TOKENS_HEALTH_SCORE=512
OPENAI_MAX_TOKENS_CAMERA_ANALYSIS=1024
OPENAI_MAX_TOKENS_ANOMALY_EXPLANATION=256
OPENAI_MAX_TOKENS_DAILY_INSIGHT=128

# ── CLOUDFLARE R2 (Image Storage) ────────────────────────────
# [SECRET] Server only
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret
CLOUDFLARE_R2_BUCKET_NAME=pet-health-images
CLOUDFLARE_R2_PUBLIC_URL=https://images.pethealthos.com

# ── STRIPE (Payments) ─────────────────────────────────────────
# [PUBLIC]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# [SECRET] Server only
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (from Stripe dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_TRIAL_DAYS=14

# ── ONESIGNAL (Push Notifications) ───────────────────────────
# [PUBLIC]
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-app-id

# [SECRET] Server only
ONESIGNAL_API_KEY=your-rest-api-key

# ── RESEND (Email) ────────────────────────────────────────────
# [SECRET] Server only
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@pethealthos.com

# ── OBSERVABILITY ─────────────────────────────────────────────
# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=your-sentry-token
SENTRY_ORG=moji-inc
SENTRY_PROJECT=pet-health-os

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── UPSTASH REDIS (Rate Limiting + Caching) ───────────────────
# [SECRET] Server only
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── VERCEL ────────────────────────────────────────────────────
VERCEL_TEAM_ID=team_...
VERCEL_TOKEN=your-vercel-token

# ── CRON SECURITY ─────────────────────────────────────────────
# [SECRET] Must match header sent by Vercel Cron
CRON_SECRET=your-cron-secret-min-32-chars

# ── PAGERDUTY (On-Call) ───────────────────────────────────────
PAGERDUTY_ROUTING_KEY=your-routing-key

# ── AI CONFIGURATION ─────────────────────────────────────────
# Rate limits (requests per day per user)
AI_CAMERA_ANALYSIS_LIMIT_FREE=10
AI_CAMERA_ANALYSIS_LIMIT_PRO=50

# Anomaly detection thresholds
ANOMALY_ZSCORE_THRESHOLD=2.5
ANOMALY_IQR_MULTIPLIER=1.5
ANOMALY_MIN_BASELINE_DAYS=14

# Health score weights (must sum to 1.0)
SCORE_WEIGHT_ACTIVITY=0.20
SCORE_WEIGHT_APPETITE=0.20
SCORE_WEIGHT_STOOL=0.15
SCORE_WEIGHT_COAT=0.15
SCORE_WEIGHT_EYES=0.15
SCORE_WEIGHT_ENERGY=0.15

# AI confidence thresholds
AI_MIN_CONFIDENCE_FOR_ALERT=0.50
AI_HUMAN_REVIEW_THRESHOLD=0.40
